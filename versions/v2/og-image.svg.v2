<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <!-- Background -->
  <rect width="1200" height="630" fill="#f8f8f6" />
  
  <!-- Decorative elements -->
  <rect x="0" y="0" width="1200" height="80" fill="#365a45" />
  <rect x="0" y="550" width="1200" height="80" fill="#794957" />
  
  <!-- Main content -->
  <text x="600" y="200" font-family="Avenir Next, Avenir, Trebuchet MS, Ubuntu, system-ui, sans-serif" font-size="64" font-weight="600" text-anchor="middle" fill="#222724" letter-spacing="-2">Edoardo Rana</text>
  
  <text x="600" y="280" font-family="ui-monospace, SFMono-Regular, Cascadia Code, Consolas, Ubuntu Mono, Liberation Mono, monospace" font-size="24" text-anchor="middle" fill="#626a64">Sistemi &middot; Dati &middot; Automazione</text>
  
  <text x="600" y="360" font-family="Avenir Next, Avenir, Trebuchet MS, Ubuntu, system-ui, sans-serif" font-size="32" text-anchor="middle" fill="#365a45" letter-spacing="-0.5">Consulenza tecnica su infrastrutture, database e analisi dei dati</text>
  
  <!-- Decorative accent -->
  <rect x="100" y="400" width="40" height="4" fill="#365a45" />
  
  <!-- URL -->
  <text x="600" y="500" font-family="ui-monospace, SFMono-Regular, Cascadia Code, Consolas, Ubuntu Mono, Liberation Mono, monospace" font-size="20" text-anchor="middle" fill="#626a64">edoardorana.github.io</text>
  
  <!-- Brand mark -->
  <text x="100" y="500" font-family="Avenir Next, Avenir, Trebuchet MS, Ubuntu, system-ui, sans-serif" font-size="32" font-weight="600" fill="#794957" letter-spacing="-1">Edo.</text>
</svg>
